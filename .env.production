# DeepWood client config for PRODUCTION builds.
#
# Committed on purpose. Every value here is public information:
#   - the RPC is a public endpoint on the chain's own domain, no API key
#   - VITE_GAME_ADDRESS / VITE_TOKEN_ADDRESS are contract addresses, public by
#     definition -- they are in the browser's network tab either way
#   - VITE_CHAIN_ID is a number
#
# There is no credential in this file. Anything secret (a key, a bearer token,
# a provider URL with an embedded key) belongs in a Vercel PROJECT env var and
# must NEVER be committed here -- the VITE_ prefix means Vite inlines the value
# into the public bundle, readable by anyone who loads the site.
#
# .env.local (gitignored) still overrides this locally.
VITE_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Backup endpoint. The primary has been observed answering with WRONG values
# rather than failing (a short code blob for a 36KB contract, and once a
# fallback to a local node). A player cannot tell they are seeing a wrong
# balance, so reads that look implausible are retried here. Comma-separated.
VITE_RPC_FALLBACKS=https://robinhood-testnet.drpc.org
# DeepWoodV2. Deployed on 46630; preseason open, seed 0x66910f...ddf79
# (published at deepwood-contracts commit 185e5a9 before it was committed).
VITE_GAME_ADDRESS=0x871cb5c1d764788c17d2d9ba7df266c32fe6a7fa
VITE_CHAIN_ID=46630
VITE_TOKEN_ADDRESS=0xF049d0076c2f25A763551beD760aB55e905ea831

# Sentry DSN. PUBLISHABLE by design: it identifies the project and lets
# anyone send events, but grants no access and cannot read player data, so it
# is safe to commit. NOT like an RPC key or a private key -- those must never
# be committed. Remove it from .env.local if you want local dev errors to stay
# on the machine instead of going to Sentry.
VITE_SENTRY_DSN=https://1ab612e8fbceba6023cb0efd4ae55a32@o4512183620534272.ingest.us.sentry.io/4512183687184384
