# DeepWood client runtime config.
#
# Copy to .env.local (gitignored) and edit. Vite only exposes VITE_* vars, so
# nothing private belongs here -- these are public addresses and a public RPC
# endpoint. Never put a private key or a seed phrase in a VITE_ var: it would
# ship inside the JS bundle.

# Public JSON-RPC endpoint for the chain the game is deployed on.
VITE_RPC_URL=https://rpc.testnet.chain.robinhood.com

# The deployed DeepWood game contract.
#   testnet 46630: 0xCDAd67Ed7165a42a74A7324275Da11f0F9f98b8A
VITE_GAME_ADDRESS=0xCDAd67Ed7165a42a74A7324275Da11f0F9f98b8A

# Expected chain id (decimal). The client refuses to read if the RPC is on a
# different chain, so a mistyped RPC cannot silently show the wrong contract.
VITE_CHAIN_ID=46630

# Optional: the project's launched token, shown in the UI once wired.
VITE_TOKEN_ADDRESS=0xF049d0076c2f25A763551beD760aB55e905ea831
# IMPORTANT for Vercel
# .env.local is gitignored, so it never reaches the build. Set these as
# PROJECT environment variables (Vercel dashboard, or `vercel env add`), or the
# build will produce the "offline" version with no address compiled in.
#   Vercel dashboard -> Settings -> Environment Variables
#     VITE_RPC_URL, VITE_GAME_ADDRESS, VITE_CHAIN_ID, VITE_TOKEN_ADDRESS
# The VITE_ prefix is required; Vite strips anything else from the client.
#
# Sanity check after deploying: the topbar should read "live" and the tooltip
# should name the contract. If it says "offline", the env var did not arrive.
